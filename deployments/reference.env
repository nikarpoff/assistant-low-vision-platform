# Эталонная конфигурация (DEP-2, DEP-3, LLM-2): несекретные значения, по которым идут замеры.
# Лежит в git и передаётся вторым --env-file после .env, поэтому её значения главнее:
#
#   docker compose --env-file .env --env-file reference.env -f compose.vm.yml up -d
#   docker compose --env-file .env --env-file reference.env -f compose.models.yml up -d
#
# Секретов здесь нет и быть не должно. Поставщика, модели и теги образов перед замерами
# фиксирует задача 002. Пока APP_LLM_MODEL пуст, Шлюз в режиме llm не стартует и пишет
# понятную ошибку: стенд нельзя случайно принять за эталонный.
#
# Пустое значение здесь тоже перекрывает .env: пустые поля моделей сервисов дают бэкенд fake,
# пустой тег - latest.

# Вариант размещения: эталонный - B (compose.vm.yml); compose.single.yml всегда ставит A
APP_PLACEMENT=B
APP_DESCRIBER_MODE=llm

# Поставщик и модели языковой модели (задача 002)
APP_LLM_URL=https://polza.ai/api/v1
APP_LLM_MODEL=
APP_VLM_MODEL=

# Бэкенды и модели сервисов (задача 002)
DETECTOR_MODEL_BACKEND=
DETECTOR_MODEL_NAME=
ASR_MODEL_BACKEND=
ASR_MODEL_NAME=
TTS_MODEL_BACKEND=
TTS_MODEL_NAME=

# Теги образов (задача 002)
ALV_IMAGE_TAG=
