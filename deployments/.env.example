# Настройки развёртывания обеих машин (DEP-2). Скопируйте в .env на каждом хосте:
#
#   cp .env.example .env
#
# .env в git не попадает. Секреты здесь пустые - заполните их только в .env.
# Пустое значение - значение по умолчанию из файла compose.
# На эталонном стенде вторым --env-file передаётся reference.env, его значения главнее:
#
#   docker compose --env-file .env --env-file reference.env -f compose.vm.yml up -d
#
# В скобках - где переменная нужна:
#   VM-B    - compose.vm.yml (VM, вариант B);
#   MODELS  - compose.models.yml (машина моделей, вариант B);
#   SINGLE  - compose.single.yml (машина моделей, вариант A);
#   PROXY   - compose.vm-proxy.yml (VM, вариант A);
#   FAKE    - compose.fake.yml (сквозная проверка).

# =====================================================================
# 1. Домен, туннель, образы
# =====================================================================

# Домен приложения; его A-запись указывает на публичный IP VM (VM-B, PROXY)
ALV_DOMAIN=alv.example.com
# Куда Caddy проксирует Шлюз; пусто - gateway:80 в alv-net (VM-B) или ${ALV_TUNNEL_MODELS_IP}:8080 через туннель (PROXY)
ALV_GATEWAY_UPSTREAM=
# Адрес VM в туннеле WireGuard (wireguard/*.conf.example)
ALV_TUNNEL_VM_IP=10.77.0.1
# Адрес машины моделей в туннеле: на нём публикуются порты сервисов и Шлюза варианта A (VM-B, MODELS, SINGLE, PROXY)
ALV_TUNNEL_MODELS_IP=10.77.0.2
# Тег своих образов ghcr.io/nikarpoff/*: latest, v0.1.0; у сервисов к нему добавляется -cpu или -cuda (все файлы)
ALV_IMAGE_TAG=latest

# =====================================================================
# 2. Шлюз (VM-B, SINGLE, FAKE). Полная таблица - README репозитория
# =====================================================================

APP_LOG_LEVEL=INFO
# true - работа без токенов, только для разработки
APP_AUTH_DISABLED=false
# Секрет: токены устройств через запятую, например `openssl rand -hex 32`
APP_DEVICE_TOKENS=
# Секрет: токен /v1/stats и /v1/config
APP_ADMIN_TOKEN=

# Режим описания: template, llm, vlm (vlm - только в экспериментах с согласием, NFR-8)
APP_DESCRIBER_MODE=llm
# Метка варианта размещения в config_id; пусто - B (VM-B); в SINGLE всегда A, в FAKE - dev
APP_PLACEMENT=
APP_PROMPT=default
APP_MAX_ANSWER_CHARS=220
APP_VLM_WITH_DETECTIONS=true
APP_SCENE_FRESHNESS_MS=10000

# =====================================================================
# 3. Поставщик языковой модели (VM-B, SINGLE)
# =====================================================================
# Polza.ai:  APP_LLM_URL=https://polza.ai/api/v1, APP_LLM_API_KEY - ключ Polza.ai.
# GigaChat:  APP_LLM_URL=http://gpt2giga:8090/v1, APP_LLM_API_KEY - ключ доступа к прокси
#            (любая длинная случайная строка, становится GPT2GIGA_API_KEY), профиль compose gigachat
#            и GIGACHAT_CREDENTIALS ниже.
# Смена модели - одна переменная APP_LLM_MODEL. Модели эталонной конфигурации - в reference.env.

APP_LLM_URL=https://polza.ai/api/v1
# Секрет: ключ Polza.ai или ключ доступа к gpt2giga
APP_LLM_API_KEY=
# Идентификатор модели режима llm; без него Шлюз в режиме llm не стартует
APP_LLM_MODEL=
# Мультимодальная модель режима vlm; пусто - APP_LLM_MODEL
APP_VLM_MODEL=
APP_LLM_TEMPERATURE=0
APP_LLM_SEED=42
APP_LLM_MAX_TOKENS=96
# JSON, добавляемый в тело запроса, например выключение рассуждений
APP_LLM_EXTRA_BODY={}

# =====================================================================
# 4. Таймауты и поведение Шлюза (VM-B, SINGLE, FAKE), миллисекунды и секунды
# =====================================================================

APP_DETECT_TIMEOUT_MS=400
APP_ASR_TIMEOUT_MS=2000
APP_LLM_TTFT_TIMEOUT_MS=900
APP_LLM_TOTAL_TIMEOUT_MS=5000
APP_TTS_FIRST_CHUNK_TIMEOUT_MS=1000
APP_REQUEST_DEADLINE_MS=8000
APP_PASSIVE_DEADLINE_MS=1500
APP_PASSIVE_NOTICES=false
APP_HAZARD_COOLDOWN_MS=10000
APP_HISTORY_SCENES=5
APP_HISTORY_TURNS=6
APP_HISTORY_TTL_S=600
# Голос TTS; пусто - голос сервиса по умолчанию
APP_TTS_VOICE=
APP_IMAGE_MAX_SIDE=640
APP_JPEG_QUALITY=80
APP_PASSIVE_INTERVAL_MS=3000
APP_LISTEN_WINDOW_MS=5000
APP_MAX_QUESTION_MS=15000
APP_AUDIO_OUT_SAMPLE_RATE=24000
APP_MAX_IMAGE_BYTES=2097152
APP_JOURNAL_BUFFER=1024
APP_CONFIG_REFRESH_S=60

# =====================================================================
# 5. PostgreSQL (VM-B, SINGLE, FAKE)
# =====================================================================

# Секрет: пароль журнала, только буквы и цифры (он входит в строку подключения), например `openssl rand -hex 24`
POSTGRES_PASSWORD=

# =====================================================================
# 6. gpt2giga, профиль gigachat (VM-B, SINGLE)
# =====================================================================
# Проверка TLS (GIGACHAT_VERIFY_SSL_CERTS=True) и сертификат НУЦ заданы в compose и отсюда не меняются.

# Секрет: ключ авторизации GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель прокси по умолчанию; Шлюз всё равно передаёт model (APP_LLM_MODEL) в каждом запросе
GIGACHAT_MODEL=GigaChat-2

# =====================================================================
# 7. Сервисы ИИ-моделей (MODELS, SINGLE; токены - ещё VM-B и FAKE)
# =====================================================================
# fake отвечает без весов и видеокарты; настоящие модели задаются здесь или в reference.env.
# Пустая модель - модель бэкенда по умолчанию. Веса заранее скачивает ./fetch-weights.sh.
# Один токен задаёт и AUTH_TOKEN сервиса, и токен Шлюза к нему (APP_*_TOKEN).

# Детектор. Бэкенды-кандидаты: ultralytics, rfdetr, onnx, grounding_dino
DETECTOR_MODEL_BACKEND=fake
DETECTOR_MODEL_NAME=
# cuda (образ -cuda) или cpu
DETECTOR_TARGET_PLATFORM=cuda
# Секрет: токен детектора
DETECTOR_AUTH_TOKEN=
DETECTOR_WORKERS=1
DETECTOR_QUEUE_MAX=4

# ASR. Бэкенды-кандидаты: gigaam, tone, whisper, vosk
ASR_MODEL_BACKEND=fake
ASR_MODEL_NAME=
ASR_TARGET_PLATFORM=cuda
# Секрет: токен ASR
ASR_AUTH_TOKEN=
ASR_WORKERS=1
ASR_QUEUE_MAX=4

# TTS (образ -cpu). Бэкенды-кандидаты: silero, piper, f5tts
TTS_MODEL_BACKEND=fake
TTS_MODEL_NAME=
TTS_TARGET_PLATFORM=cpu
# Секрет: токен TTS
TTS_AUTH_TOKEN=
TTS_WORKERS=1
TTS_QUEUE_MAX=4
